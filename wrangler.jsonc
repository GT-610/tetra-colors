{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tetra-colors",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDO"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
