{
  "name": "tetra-colors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && wrangler dev",
    "client:dev": "vite",
    "build": "vite build",
    "test": "bun run build && vitest run",
    "test:watch": "bun run build && vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "deploy": "bun run build && wrangler deploy",
    "logs": "wrangler tail",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "fast-check": "^4.3.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.129.0",
    "ws": "^8.18.3"
  }
}
